// Auto-generated by CMake (configure_file) from cmake/ovcli_config.h.in.
// Plain constants only (no generator expressions) so it is stable and usable
// by both ovcli_core and the tests. The worker binary path for the integration
// test is injected separately as a per-target compile definition, not here.
#ifndef OVCLI_CONFIG_H
#define OVCLI_CONFIG_H

#define OVCLI_VERSION "@PROJECT_VERSION@"

// Line-JSON protocol version and the per-line byte limit (256 MiB). The wire
// protocol is its own; over-limit lines are fatal.
#ifndef OVCLI_PROTOCOL_VERSION
#define OVCLI_PROTOCOL_VERSION 1
#endif
#ifndef OVCLI_PROTOCOL_LINE_LIMIT
#define OVCLI_PROTOCOL_LINE_LIMIT 268435456
#endif

#endif // OVCLI_CONFIG_H
