// Auto-generated by CMake (configure_file) from cmake/ovgenai_config.h.in.
// Plain constants only (no generator expressions) so it is stable and usable
// by both ovgenai_core and the tests. The worker binary path for the integration
// test is injected separately as a per-target compile definition, not here.
#ifndef OVGENAI_CONFIG_H
#define OVGENAI_CONFIG_H

#define OVGENAI_VERSION "@PROJECT_VERSION@"

// Line-JSON protocol version and the per-line byte limit (256 MiB). The wire
// protocol is its own; over-limit lines are fatal.
#ifndef OVGENAI_PROTOCOL_VERSION
#define OVGENAI_PROTOCOL_VERSION 1
#endif
#ifndef OVGENAI_PROTOCOL_LINE_LIMIT
#define OVGENAI_PROTOCOL_LINE_LIMIT 268435456
#endif

#endif // OVGENAI_CONFIG_H
